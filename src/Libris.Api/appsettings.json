{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "tauri://localhost",
      "http://tauri.localhost",
      "http://localhost:1420"
    ]
  },
  "Jwt": {
    "Issuer": "libris",
    "Audience": "libris-app",
    "Key": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 90
  },
  "Auth": {
    "AllowSignup": false,
    "LoginPermitPerMinute": 10
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
